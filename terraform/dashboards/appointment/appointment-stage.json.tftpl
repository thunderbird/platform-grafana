    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${victorialogs_uid}"
      },
      "description": "Tasks the worker reported succeeded, failed (raised) or retried, per minute. There is no Celery metrics exporter on tb-dev (Flower is out of scope in thunderbird/appointment-deploy#19), so these panels count Celery's own INFO log lines that Vector ships.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
