        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "max(kube_job_status_succeeded{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",job_name=~\"appointment-migrate.*\"})",
          "legendFormat": "succeeded",
          "refId": "A"
        }
      ],
      "title": "Migrate Job succeeded",
      "type": "stat"
    },
