  "description": "AMO production overview: amo-prod and amo-prod-versioncheck ALBs, the six atn-web-stream9 instances, and the versioncheck/services CloudFront edges, all in thunderbird-legacy (768512802988).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Issue #405 - AMO overview dashboard",
      "tooltip": "",
      "type": "link",
      "url": "https://github.com/thunderbird/addons-server/issues/405"
    },
    {
      "asDropdown": false,
      "icon": "external link",
