    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "description": "Time series for each parenthesized Stalwart event containing queue, including queueing and delivery outcome variants.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^log_group_key:.*stats by \\(/"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "(queue.queue-message)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 11,
        "x": 0,
        "y": 1
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "editorMode": "code",
          "expr": "log_group_key:\"stalwart-stage\" queue | filter _msg:~\"(?i)[(][^)]*queue[^)]*[)]\" | extract_regexp \"(?i)(?P<queue_event>[(][^)]*queue[^)]*[)])\" | stats by (queue_event) count()",
          "legendFormat": "{{queue_event}}",
          "queryType": "statsRange",
          "refId": "A"
        }
      ],
      "title": "Queue Event Counts",
      "type": "timeseries"
    },
