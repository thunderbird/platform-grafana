          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${victorialogs_uid}"
          },
          "expr": "cluster:\"mzla-eks-tb-dev01\" AND namespace:\"appointment\" AND pod:\"appointment-worker-\"* AND \"succeeded in\" | stats count() succeeded",
          "queryType": "statsRange",
          "refId": "A",
          "step": "1m"
        },
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
