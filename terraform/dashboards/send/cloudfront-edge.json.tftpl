          },
          "expression": "",
          "id": "",
          "legendFormat": "CacheHitRate",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricName": "CacheHitRate",
          "metricQueryType": 0,
          "namespace": "AWS/CloudFront",
