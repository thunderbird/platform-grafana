    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_tb_dev_uid}"
      },
      "description": "Time from CloudFront receiving a request to returning the last byte to the edge for origin-bound (cache-miss) requests. Only percentile statistics are valid for this metric. Published because the per-distribution MonitoringSubscription is live (platform-infrastructure #895). p90 is alerted on at > 3000ms for 15m, gated on more than 50 requests in the bucket, in terraform/alerting-send-edge.tf.",
      "fieldConfig": {
