      "type": "row"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch_tb_dev_uid}"
      },
      "description": "Route53 aggregate health of https://send.tb-dev.thunderbird.dev/api/health (HTTPS_STR_MATCH on \"API is alive\", platform-infrastructure #1052). 1 = healthy, 0 = unhealthy. This is the aggregate: it holds at 1 while more than 18% of checkers are healthy, so it is a GLOBAL-outage detector. For partial/regional failure watch Percentage Healthy to the right. Alerted on at < 1 for 3m in terraform/alerting-send-edge.tf.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Unhealthy"
                },
                "1": {
                  "color": "green",
                  "text": "Healthy"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
