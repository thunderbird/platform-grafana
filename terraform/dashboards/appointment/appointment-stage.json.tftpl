    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Container restarts across the namespace in the last hour.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\"}[1h])) or vector(0)",
          "legendFormat": "restarts",
          "refId": "A"
        }
      ],
      "title": "Restarts (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "kube_pod_status_phase summed per phase for the appointment namespace.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum by (phase) (kube_pod_status_phase{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "title": "Pod phase",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Restart rate per container, 15m window. A step up on backend during a rollout means the new revision is crash looping behind the preview Service.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum by (pod, container) (rate(kube_pod_container_status_restarts_total{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\"}[15m]))",
          "legendFormat": "{{pod}}/{{container}}",
          "refId": "A"
        }
      ],
      "title": "Container restarts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Pods whose Ready condition is false, per pod. Anything non-zero for more than a few minutes after a sync is a stuck revision.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum by (pod) (kube_pod_status_ready{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",condition=\"false\"}) > 0",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Not ready pods",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 9,
      "panels": [],
      "title": "Rollouts (Argo Rollouts blue-green)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Phase label of rollout_info for the Rollout. Healthy is the steady state; Paused means a blue-green revision is waiting on prePromotionAnalysis; Degraded means the analysis failed and the active Service stayed on the old pods. Needs the Argo Rollouts controller metrics: turn on controller.metrics.enabled and its ServiceMonitor in argocd/tb-dev/helm-values/argo-rollouts.yaml (platform-infrastructure). Empty until then.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "max by (phase) (rollout_info{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",name=\"appointment-backend\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "title": "Backend rollout phase",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Revision number of the newest prePromotionAnalysis AnalysisRun for this Rollout, parsed from its name (rollout-podhash-revision-pre). Argo Rollouts keeps only the last few AnalysisRuns, so this is the current revision as long as the Rollout has promoted at least once since the controller last garbage-collected.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "id": 11,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "max(label_value(label_replace(analysis_run_info{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",name=~\"appointment-backend-[a-z0-9]+-[0-9]+-pre\"}, \"revision\", \"$1\", \"name\", \".*-([0-9]+)-pre\"), \"revision\"))",
          "legendFormat": "revision",
          "refId": "A"
        }
      ],
      "title": "Backend revision",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Phase label of rollout_info for the Rollout. Healthy is the steady state; Paused means a blue-green revision is waiting on prePromotionAnalysis; Degraded means the analysis failed and the active Service stayed on the old pods. Needs the Argo Rollouts controller metrics: turn on controller.metrics.enabled and its ServiceMonitor in argocd/tb-dev/helm-values/argo-rollouts.yaml (platform-infrastructure). Empty until then.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 14
      },
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "max by (phase) (rollout_info{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",name=\"appointment-frontend\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "title": "Frontend rollout phase",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Revision number of the newest prePromotionAnalysis AnalysisRun for this Rollout, parsed from its name (rollout-podhash-revision-pre). Argo Rollouts keeps only the last few AnalysisRuns, so this is the current revision as long as the Rollout has promoted at least once since the controller last garbage-collected.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "id": 13,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "max(label_value(label_replace(analysis_run_info{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",name=~\"appointment-frontend-[a-z0-9]+-[0-9]+-pre\"}, \"revision\", \"$1\", \"name\", \".*-([0-9]+)-pre\"), \"revision\"))",
          "legendFormat": "revision",
          "refId": "A"
        }
      ],
      "title": "Frontend revision",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "prePromotionAnalysis AnalysisRuns the controller still holds (Argo Rollouts keeps the last few per Rollout), newest revision first. The top row per Rollout is the result of its last analysis: Successful means the active Service flipped to the new pods; Failed or Error means the old pods kept serving and the Rollout is Degraded. Needs the Argo Rollouts controller metrics: turn on controller.metrics.enabled and its ServiceMonitor in argocd/tb-dev/helm-values/argo-rollouts.yaml (platform-infrastructure). Empty until then.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "Error": {
                  "color": "red",
                  "index": 2
                },
                "Failed": {
                  "color": "red",
                  "index": 1
                },
                "Inconclusive": {
                  "color": "orange",
                  "index": 4
                },
                "Running": {
                  "color": "blue",
                  "index": 3
                },
                "Successful": {
                  "color": "green",
                  "index": 0
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "phase"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 14,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "revision"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "label_value(label_replace(label_replace(analysis_run_info{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",name=~\"appointment-(backend|frontend)-[a-z0-9]+-[0-9]+-pre\"}, \"revision\", \"$1\", \"name\", \".*-([0-9]+)-pre\"), \"rollout\", \"$1\", \"name\", \"^(appointment-(backend|frontend))-.*\"), \"revision\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "prePromotionAnalysis runs (newest first)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "prometheus": true,
              "region": true,
              "service": true
            },
            "indexByName": {
