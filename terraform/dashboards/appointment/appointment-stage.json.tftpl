  "description": "Appointment on tb-dev (mzla-eks-tb-dev01, namespace appointment) for the stage cutover: pods, Argo Rollouts, the Alembic migrate Job, the origin ALB, the CloudFront edge, Celery and logs, so engineers can tell an app problem from an edge problem.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Issue #43: Appointment stage dashboard",
      "tooltip": "",
      "type": "link",
      "url": "https://github.com/thunderbird/platform-grafana/issues/43"
    },
    {
