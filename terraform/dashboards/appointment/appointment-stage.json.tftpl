    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "kube_job_status_succeeded for the Alembic Sync hook Job (thunderbird/appointment-deploy#23). BeforeHookCreation keeps the last Job until the next sync, so this shows the most recent run. Empty until that PR lands.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "NO"
                },
                "1": {
                  "color": "green",
                  "text": "YES"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
