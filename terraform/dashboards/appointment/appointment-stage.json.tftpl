      "title": "Pods",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Ready pods, from kube_pod_status_ready (kube-state-metrics on tb-dev) filtered on the pod name prefix. Pods of a Rollout preview ReplicaSet count too while prePromotionAnalysis runs.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "count(kube_pod_status_ready{cluster=\"mzla-eks-tb-dev01\",namespace=\"appointment\",condition=\"true\",pod=~\"appointment-backend-.*\"} == 1) or vector(0)",
          "legendFormat": "ready",
          "refId": "A"
        }
      ],
      "title": "Backend ready",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "description": "Ready pods, from kube_pod_status_ready (kube-state-metrics on tb-dev) filtered on the pod name prefix. Pods of a Rollout preview ReplicaSet count too while prePromotionAnalysis runs.",
      "fieldConfig": {
        "defaults": {
