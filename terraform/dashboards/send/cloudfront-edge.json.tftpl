            "type": "cloudwatch",
            "uid": "${cloudwatch_tb_dev_uid}"
          },
          "dimensions": {
            "HealthCheckId": "${send_health_check_id}"
          },
          "expression": "",
          "id": "",
          "legendFormat": "HealthCheckStatus",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricName": "HealthCheckStatus",
          "metricQueryType": 0,
          "namespace": "AWS/Route53",
          "period": "60",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "us-east-1",
          "statistic": "Minimum"
        }
      ],
      "title": "Health Check Status (aggregate)",
      "type": "timeseries"
    },
    {
      "datasource": {
