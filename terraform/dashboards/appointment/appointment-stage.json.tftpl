          "refId": "B",
          "step": "1m"
        },
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${victorialogs_uid}"
          },
          "expr": "cluster:\"mzla-eks-tb-dev01\" AND namespace:\"appointment\" AND pod:\"appointment-worker-\"* AND \"] retry:\" | stats count() retried",
          "queryType": "statsRange",
          "refId": "C",
          "step": "1m"
